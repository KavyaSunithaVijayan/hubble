generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Show {
  id         Int         @id
  name       String
  startDate  DateTime
  endDate    DateTime
  exhibitors Exhibitor[]
}

model Exhibitor {
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  boothNo          String?
  companyName      String
  countryId        Int?
  hallNo           String?
  showId           Int
  squareLogo       String?
  userId           String?
  id               Int                @id
  Country          Country?           @relation(fields: [countryId], references: [id])
  show             Show               @relation(fields: [showId], references: [id])
  ExhibitorProduct ExhibitorProduct[]

  @@index([showId])
  @@index([countryId])
}

model Country {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  Exhibitor Exhibitor[]
}

model ExhibitorProduct {
  id           Int       @id
  productName  String
  productType  String?
  productImage String?
  specialType  String?
  showId       Int
  exhibitorId  Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  Exhibitor    Exhibitor @relation(fields: [exhibitorId], references: [id])

  @@index([exhibitorId])
  @@index([showId])
}

model Product {
  id          String   @id
  name        String
  slug        String   @unique
  tagline     String?
  description String
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  modelUrl    String?
}

model consult_requests {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  company   String?
  message   String
  createdAt DateTime @default(now())
}
